# 演示账号生成脚本使用的环境变量（复制为 .env 后填写，.env 不入库）
# 用途：scripts/seed-demo.mjs 初始化管理员与会员演示账号

# 管理员（作者）演示账号
DEMO_ADMIN_EMAIL=admin@oss-blog.local
DEMO_ADMIN_NAME=瑞维
DEMO_ADMIN_PASSWORD=

# 普通会员演示账号
DEMO_MEMBER_EMAIL=member@oss-blog.local
DEMO_MEMBER_NAME=小明
DEMO_MEMBER_PASSWORD=

# 第二位会员（用于评论权限演示）
DEMO_MEMBER2_EMAIL=reader@oss-blog.local
DEMO_MEMBER2_NAME=读者乙
DEMO_MEMBER2_PASSWORD=
