<div id="search-panel" class="search-panel" hidden>
    <div class="search-panel__backdrop" data-search-close></div>
    <div class="search-panel__dialog" role="dialog" aria-modal="true" aria-label="站内搜索">
        <div class="search-panel__bar">
            <input id="search-input" class="search-panel__input" type="search" placeholder="输入关键词，按标签或标题/正文搜索…" aria-label="搜索关键词">
            <button class="search-panel__close" type="button" data-search-close aria-label="关闭搜索">✕</button>
        </div>
        <div id="search-results" class="search-panel__results" aria-live="polite"></div>
    </div>
</div>
